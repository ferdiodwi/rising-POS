# ── Release Signing ───────────────────────────────────────────────────────────
# Salin file ini menjadi `keystore.properties` (di root project) lalu isi nilainya.
# `keystore.properties` TIDAK boleh di-commit — sudah ada di .gitignore.
#
# Membuat keystore rilis baru (sekali saja, simpan file & password dengan aman!):
#
#   keytool -genkeypair -v \
#     -keystore rising-pos-release.jks \
#     -alias rising-pos \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# PENTING: bila keystore/password hilang, kamu TIDAK akan pernah bisa meng-update
# aplikasi yang sudah terpasang di Play Store. Simpan backup di tempat aman.

storeFile=rising-pos-release.jks
storePassword=GANTI_DENGAN_PASSWORD_KEYSTORE
keyAlias=rising-pos
keyPassword=GANTI_DENGAN_PASSWORD_KEY
